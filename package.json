{
  "name": "lumen",
  "productName": "Lumen",
  "version": "4.4.4",
  "description": "Lumen - a fast, private browser",
  "main": "src/main.js",
  "author": "Nauman Munir",
  "license": "UNLICENSED",
  "lumen": {
    "repo": "mabdulhadi0208-afk/lumen"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "darkreader": "^4.9.135",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.lumen.browser",
    "productName": "Lumen",
    "copyright": "Copyright 2026 Nauman Munir",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "pages/**/*",
      "build/icon.png",
      "build/icons/*.png",
      "package.json"
    ],
    "asar": true,
    "afterPack": "build/after-pack.js",
    "protocols": [
      {
        "name": "Web site",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml",
          "shtml",
          "webp",
          "svg",
          "pdf"
        ],
        "name": "Web document",
        "role": "Viewer",
        "rank": "Alternate",
        "icon": "build/doc/document"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Lumen-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationUsageDescription": "Websites you allow can use your location.",
        "NSLocationWhenInUseUsageDescription": "Websites you allow can use your location.",
        "NSBluetoothAlwaysUsageDescription": "Websites you allow can connect to Bluetooth devices.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "Lumen",
      "artifactName": "Lumen-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 180,
          "y": 190
        },
        {
          "x": 480,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 420
      },
      "background": "build/dmg/background.png",
      "iconSize": 128,
      "iconTextSize": 13
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lumen-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen",
      "installerIcon": "build/nsis/installerIcon.ico",
      "uninstallerIcon": "build/nsis/uninstallerIcon.ico",
      "installerHeaderIcon": "build/nsis/installerIcon.ico",
      "installerSidebar": "build/nsis/installerSidebar.bmp",
      "uninstallerSidebar": "build/nsis/uninstallerSidebar.bmp",
      "installerHeader": "build/nsis/installerHeader.bmp"
    }
  }
}
